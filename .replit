modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
NOTIFY_EMAIL = "eaucnordic@gmail.com"
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
RESEND_FROM = "EAUC Nordic <noreply@eaucnordic.com>"
